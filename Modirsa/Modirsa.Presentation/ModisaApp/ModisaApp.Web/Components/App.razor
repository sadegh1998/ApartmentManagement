<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="_content/ModisaApp.Shared/bootstrap/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="_content/ModisaApp.Shared/site.css" />
    <link rel="stylesheet" href="ModisaApp.Web.styles.css" />
    <link rel="icon" type="image/png" href="_content/ModisaApp.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    
    <script>
        // Circuit state logging
        window.addEventListener('beforeunload', function () {
            console.log('Page is being unloaded');
        });
        
        // Blazor circuit events
        window.addEventListener('blazor:reload', function () {
            console.log('Blazor circuit reloading');
        });
        
        window.addEventListener('blazor:circuit:disconnected', function () {
            console.log('Blazor circuit disconnected');
        });
        
        window.addEventListener('blazor:circuit:connected', function () {
            console.log('Blazor circuit connected');
        });
    </script>
</body>

</html>
