<MudDrawer @bind-Open="_drawerOpen" Overlay="false" Class="baackdrop-bluered" ClipMode="DrawerClipMode.Always">
    <MudNavMenu>
        <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">داشبورد</MudNavLink>
        
        <MudNavGroup Title="ساختمان" Icon="@Icons.Material.Filled.Apartment" IsExpanded="true">
            <MudNavLink Href="/Building/List" Icon="@Icons.Material.Filled.Apartment">لیست ساختمان‌ها</MudNavLink>
            <MudNavLink Href="/Building/Create" Icon="@Icons.Material.Filled.Add">افزودن ساختمان</MudNavLink>
            <MudNavLink Href="/Unit/List" Icon="@Icons.Material.Filled.Home">لیست واحدها</MudNavLink>
            <MudNavLink Href="/Unit/Create" Icon="@Icons.Material.Filled.Add">افزودن واحد</MudNavLink>
        </MudNavGroup>
        
        <MudNavGroup Title="هزینه‌ها" Icon="@Icons.Material.Filled.Money" IsExpanded="true">
            <MudNavLink Href="/Expense/List" Icon="@Icons.Material.Filled.List">لیست هزینه‌ها</MudNavLink>
            <MudNavLink Href="/Expense/Create" Icon="@Icons.Material.Filled.Add">افزودن هزینه</MudNavLink>
            <MudNavLink Href="/ExpenseUnit/List" Icon="@Icons.Material.Filled.Assignment">تخصیص هزینه‌ها</MudNavLink>
            <MudNavLink Href="/ExpenseUnit/Create" Icon="@Icons.Material.Filled.Add">افزودن تخصیص هزینه</MudNavLink>
        </MudNavGroup>
        
        <MudNavGroup Title="مالی" Icon="@Icons.Material.Filled.AccountBalance" IsExpanded="true">
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Money">صندوق</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Check">فیش ها</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Inventory">قبوض</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Deblur">لیست بدهکاران و بستانکاران</MudNavLink>
        </MudNavGroup>
        
        <MudNavGroup Title="مدیریت سیستم" Icon="@Icons.Material.Filled.Settings" IsExpanded="true">
            <MudNavLink Href="/Role/List" Icon="@Icons.Material.Filled.Security">نقش‌ها</MudNavLink>
            <MudNavLink Href="/Role/Create" Icon="@Icons.Material.Filled.Add">افزودن نقش</MudNavLink>
            <MudNavLink Href="/Permission/List" Icon="@Icons.Material.Filled.VpnKey">مجوزها</MudNavLink>
            <MudNavLink Href="/Permission/Create" Icon="@Icons.Material.Filled.Add">افزودن مجوز</MudNavLink>
        </MudNavGroup>
        
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.Wallet">کیف پول</MudNavLink>
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.AccountBox">درباره ما</MudNavLink>
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.Newspaper">اخبار</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _drawerOpen = true;
    public void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }
}
