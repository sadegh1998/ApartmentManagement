<MudDrawer @bind-Open="_drawerOpen" Overlay="false" Class="baackdrop-bluered" ClipMode="DrawerClipMode.Always">
    <MudNavMenu>
        <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">داشبورد</MudNavLink>
        <MudNavGroup Title="ساختمان" Icon="@Icons.Material.Filled.Settings">
            <MudNavLink Href="Building/List" Icon="@Icons.Material.Filled.Apartment">ساختمان من</MudNavLink>
            <MudNavLink Href="Unit/List" Icon="@Icons.Material.Filled.Apartment">لیست واحدهای ساختمان من</MudNavLink>

            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Rule">قوانین ساختمان</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.History">سوابق ساختمان</MudNavLink>
        </MudNavGroup>
        <MudNavGroup Title="مالی" Icon="@Icons.Material.Filled.Settings">
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Money">صندوق</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Check">فیش ها</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Inventory">قبوض</MudNavLink>
            <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.Deblur">لیست بدهکاران و بستانکاران</MudNavLink>

        </MudNavGroup>
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.Wallet">کیف پول</MudNavLink>
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.AccountBox">درباره ما</MudNavLink>
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.Newspaper">اخبار</MudNavLink>

    </MudNavMenu>
</MudDrawer>


@code {
    private bool _drawerOpen = true;
    public void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }
}
