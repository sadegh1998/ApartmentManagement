@page "/Building/List"
@using ModisaApp.Shared.DTO.Building
@using ModisaApp.Shared.Interfaces.Providers

@if (Buildings == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!Buildings.Any())
{
    <MudPaper Class="d-flex flex-column align-center justify-center p-6" Style="height: 300px;">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Warning" />
        <MudText Class="mt-3" Typo="Typo.h6">هیچ اطلاعاتی برای نمایش وجود ندارد</MudText>
    </MudPaper>
}
else
{
    <MudContainer Class="grid-container">
        <MudPaper Class="responsive-grid">
            <MudDataGrid Items="@Buildings"
                         SortMode="SortMode.Multiple"
                         Filterable="true"
                         Breakpoint="Breakpoint.Sm"
                         Dense="true"
                         Style="height: 400px; overflow: auto;">
                <Columns>
                    <!-- ستون ID -->
                    <PropertyColumn Property="x => x.FundBalance" Title="ID" />

                    <!-- ستون نوع سند -->
                    <PropertyColumn Property="x => x.BuildingUnitsNo" Title="نوع سند" />

                    <!-- ستون تاریخ شروع -->
                    <PropertyColumn Property="x => x.Name" Title="تاریخ شروع" />

                    <!-- ستون عملیات -->
                    <TemplateColumn Title="عملیات">
                        <CellTemplate>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                                مشاهده
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudContainer>

}



