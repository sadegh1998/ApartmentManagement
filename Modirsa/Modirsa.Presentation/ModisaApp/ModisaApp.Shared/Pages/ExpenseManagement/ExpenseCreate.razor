@page "/Expense/Create"
@using ModisaApp.Shared.DTO.Expense
@using ModisaApp.Shared.Interfaces.Providers

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">ایجاد هزینه جدید</MudText>
        
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="expense.Description" 
                                 Label="توضیحات هزینه" 
                                 Required="true" 
                                 RequiredError="توضیحات الزامی است"
                                 Variant="Variant.Outlined" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="expense.Amount" 
                                    Label="مبلغ" 
                                    Required="true" 
                                    RequiredError="مبلغ الزامی است"
                                    Variant="Variant.Outlined" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="expense.DateIncurred" 
                                  DateChanged="@((date) => expense.DateIncurred = date ?? DateTime.Now)" 
                                  Label="تاریخ هزینه" 
                                  Required="true" 
                                  RequiredError="تاریخ الزامی است"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="expense.AllocationMethod" 
                                 Label="روش تخصیص" 
                                 Required="true" 
                                 RequiredError="روش تخصیص الزامی است"
                                 Variant="Variant.Outlined" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudSelect @bind-Value="selectedBuildingId" 
                               Label="ساختمان" 
                               Required="true" 
                               RequiredError="انتخاب ساختمان الزامی است"
                               Variant="Variant.Outlined">
                        @if (buildings != null)
                        {
                            @foreach (var building in buildings)
                            {
                                <MudSelectItem Value="@building.Id">@building.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="CreateExpense" 
                               Disabled="!success">
                        ایجاد هزینه
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               OnClick="Cancel" 
                               Class="ml-2">
                        انصراف
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>
