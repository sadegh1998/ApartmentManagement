<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
    <MudPaper Elevation="10" Class="pa-8 d-flex flex-column align-center justify-center" Style="background-color: #ffffff; border-radius: 16px;">
        <!-- Circular Progress Spinner -->
        <MudProgressCircular   Color="Color.Primary" Indeterminate="true" Class="mb-4" Style="width: 48px; height: 48px;" />

        <!-- Loading Text -->
        <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Primary">
           در حال بارگذاری...
        </MudText>

        <!-- Optional: Subtext -->
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-2">
            لطفا صبر کنید
        </MudText>
    </MudPaper>
</MudContainer>