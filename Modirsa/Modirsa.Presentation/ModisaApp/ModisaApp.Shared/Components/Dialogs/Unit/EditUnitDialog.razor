@using ModisaApp.Shared.DTO.Unit
@using ModisaApp.Shared.DTO.Building

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 400px; overflow-y: auto">
            <MudForm @ref="form" @bind-IsValid="@success">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="editUnit.Name" 
                                     Label="نام واحد" 
                                     Required="true" 
                                     RequiredError="نام واحد الزامی است"
                                     Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="editUnit.UnitNumber" 
                                     Label="شماره واحد" 
                                     Required="true" 
                                     RequiredError="شماره واحد الزامی است"
                                     Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="editUnit.OwnerTenanStatus" 
                                     Label="وضعیت مالک/مستأجر" 
                                     Required="true" 
                                     RequiredError="وضعیت الزامی است"
                                     Variant="Variant.Outlined">
                            <MudSelectItem Value="@("مالک")">مالک</MudSelectItem>
                            <MudSelectItem Value="@("مستأجر")">مستأجر</MudSelectItem>
                            <MudSelectItem Value="@("خالی")">خالی</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="editUnit.NumberOfFamilyMembers" 
                                       Label="تعداد اعضای خانواده" 
                                       Min="0"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudSelect @bind-Value="selectedBuildingId" 
                                 Label="ساختمان" 
                                 Required="true" 
                                 RequiredError="انتخاب ساختمان الزامی است"
                                 Variant="Variant.Outlined">
                            @if (buildings != null)
                            {
                                @foreach (var building in buildings)
                                {
                                    <MudSelectItem Value="@building.Id">@building.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="!success">ذخیره</MudButton>
    </DialogActions>
</MudDialog>