@using ModisaApp.Shared.DTO.ExpenseUnit
@using ModisaApp.Shared.DTO.Expense
@using ModisaApp.Shared.DTO.Unit
@using ModisaApp.Shared.Interfaces.Providers
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium">
            <MudText Typo="Typo.h6" Class="mb-4">ایجاد تخصیص هزینه جدید</MudText>
            
            <MudForm @ref="form" @bind-IsValid="@success">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                                            <MudSelect T="Guid?" @bind-Value="selectedExpenseId" 
                               Label="هزینه" 
                               Required="true" 
                               RequiredError="انتخاب هزینه الزامی است"
                               Variant="Variant.Outlined">
                        @if (expenses != null)
                        {
                            @foreach (var expense in expenses)
                            {
                                <MudSelectItem T="Guid?" Value="@expense.Id">@expense.Description - @expense.Amount.ToString("N0") تومان</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                                            <MudSelect T="Guid?" @bind-Value="selectedUnitId" 
                               Label="هزینه" 
                               Required="true" 
                               RequiredError="انتخاب واحد الزامی است"
                               Variant="Variant.Outlined">
                        @if (units != null)
                        {
                            @foreach (var unit in units)
                            {
                                <MudSelectItem T="Guid?" Value="@unit.Id">@unit.Name - @unit.UnitNumber</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="expenseUnit.AmountDue" 
                                        Label="مبلغ قابل پرداخت" 
                                        Required="true" 
                                        RequiredError="مبلغ الزامی است"
                                        Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="!success">ایجاد</MudButton>
    </DialogActions>
</MudDialog>


