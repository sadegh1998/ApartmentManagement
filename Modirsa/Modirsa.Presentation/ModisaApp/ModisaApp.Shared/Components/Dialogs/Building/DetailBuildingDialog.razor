@using ModisaApp.Shared.DTO.Building
<MudDialog>
    <DialogContent>
        <MudForm ReadOnly="true">
        <MudGrid Container Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="EditBuilding.Name" Label="نام ساختمان" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="EditBuilding.Address" Label="آدرس" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="int" @bind-Value="EditBuilding.Floors" Label="تعداد طبقات" Variant="Variant.Outlined" Required="true" Type="number" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="int" @bind-Value="EditBuilding.BuildingUnitsNo" Label="تعداد واحدها" Variant="Variant.Outlined" Required="true" Type="number" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal" @bind-Value="EditBuilding.FundBalance" Label="موجودی صندوق" Variant="Variant.Outlined" Required="true" Type="number" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="EditBuilding.Image" Label="لینک تصویر (اختیاری)" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        </MudForm>
    </DialogContent>
    
</MudDialog>